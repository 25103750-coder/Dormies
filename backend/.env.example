# copy this file to .env and change the values
PORT=5000
# when the site is hosted online, use a long random text here (never keep this example value)
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRES_HOURS=8
# MySQL connection: mysql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL="mysql://root:@localhost:3306/dormies"
# online database that needs a secure (TLS) connection, like TiDB Cloud: set this to true (leave it out on your own computer)
# DB_SSL=true
